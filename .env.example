# ── which chatbot is being guarded ──────────────────────────────────────────
# mock (no key) | openai (any OpenAI-compatible server) | anthropic
PG_CHAT_PROVIDER=openai
PG_CHAT_MODEL=gpt-4o-mini
# your application's own system prompt for the chatbot (Mode A guidance is appended)
PG_CHAT_SYSTEM_PROMPT=You are a helpful assistant.

# ── judge / rewriter (default: same as chat; use a cheaper model here) ───────
#PG_JUDGE_PROVIDER=anthropic
#PG_JUDGE_MODEL=claude-opus-5
#PG_JUDGE_EFFORT=low
#PG_REWRITER_PROVIDER=none        # "none" = deterministic append instead of an LLM rewrite

# ── provider credentials ────────────────────────────────────────────────────
OPENAI_API_KEY=
#OPENAI_BASE_URL=http://host.docker.internal:11434/v1   # e.g. Ollama / vLLM
ANTHROPIC_API_KEY=

# ── policy ──────────────────────────────────────────────────────────────────
#PG_CONFIG=/app/config.yml
#PG_CONDITION=combined            # none | detect-only | single-turn-filter | A | B | combined

# ── server ──────────────────────────────────────────────────────────────────
#PG_AUTH_TOKEN=change-me          # if set, clients must send Authorization: Bearer <token>
#PG_SESSION_TTL_SECONDS=3600
#PG_MAX_SESSIONS=10000
#PG_TRACE=true
#PG_LOG_LEVEL=INFO
